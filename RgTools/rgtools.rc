#include <windows.h>

// Keep this file ASCII: llvm-rc and windres ignore the code page pragma, so
// non-ASCII characters are written as wide-string escapes (\x00E9 = e acute).
// build_release.bat reads the version from the VER_FILEVERSION line.

#define VER_FILEVERSION             1,3,0,0
#define VER_PRODUCTVERSION          1,3,0,0
#define VER_FILEVERSION_STR         "1.3"
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR

LANGUAGE LANG_ENGLISH, SUBLANG_NEUTRAL
#pragma code_page(1252)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            VALUE "Comments", "RemoveGrain, Repair, Clense, ForwardClense, BackwardClense, VerticalCleaner, TemporalRepair"
            VALUE "CompanyName", "Kassandro, tp7, pinterf"
            VALUE "FileDescription", "RgTools spatial and temporal denoisers for Avisynth"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "RgTools"
            VALUE "LegalCopyright", L"Copyright (C) 2013 Victor Efimov (tp7), 2016-2026 Ferenc Pint\x00E9r et al., MIT license; based on RemoveGrain by Kassandro"
            VALUE "OriginalFilename", "RgTools.dll"
            VALUE "ProductName", "RgTools"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1200
    END
END
